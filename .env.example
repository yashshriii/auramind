# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
GEMINI_API_KEY=""

# GEMINI_MODEL: Gemini model identifier (default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# VITE_API_URL: Frontend API URL (leave blank for relative /api paths in development/monorepo)
VITE_API_URL=""

# PORT: Server port (default 3000)
PORT=3000

# CLIENT_URL: Frontend URL for CORS configuration on backend
CLIENT_URL="http://localhost:3000"

# SUPABASE_URL: Optional Supabase project URL for cloud database persistence
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Optional Supabase service role key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=""

# NODE_ENV: development or production
NODE_ENV="development"
